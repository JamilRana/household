DATABASE_URL=postgresql://user:password@host:port/dbname?sslmode=require
DIRECT_URL=postgresql://user:password@host:port/dbname?sslmode=require

NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=
AUTH_SECRET=
ENCRYPTION_KEY=

# --- Email (needed so password-reset and email-confirmation links are actually sent) ---
# RESEND_API_KEY=
# MAIL_FROM="LifeHub <no-reply@yourdomain.com>"
# Public base URL used inside emailed links
# AUTH_URL=https://your-app.example.com
# Set to true only after email works: blocks sign-in until the address is confirmed
# REQUIRE_EMAIL_VERIFICATION=false

# --- Display ---
# Default currency code for new money entries and all amounts shown (e.g. USD, EUR, BDT)
# NEXT_PUBLIC_DEFAULT_CURRENCY=USD
